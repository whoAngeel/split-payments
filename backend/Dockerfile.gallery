FROM golang:alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -ldflags="-s -w" -o /gallery ./cmd/gallery

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /gallery /gallery
EXPOSE 4000
ENTRYPOINT ["/gallery"]
