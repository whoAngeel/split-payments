FROM golang:alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /splitter ./cmd/splitter

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /splitter /splitter
EXPOSE 4001
ENTRYPOINT ["/splitter"]
