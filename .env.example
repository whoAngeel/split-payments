# Homelab: puertos evitando conflictos (4000=rago, 4001=interledger-backend)
# Gallery API → 4003, Splitter → 4004

# PostgreSQL (rago-postgres-1, puerto 5433)
DB_PASSWORD=openpayments

# MinIO (contenedor 'minio', 192.168.1.21:9000)
MINIO_ENDPOINT=192.168.1.21:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Open Payments
WALLET_ADDRESS_URL=https://ilp.interledger-test.dev/your-wallet
KEY_ID=your-key-id-uuid
PRIVATE_KEY_PATH=./private.key

# Mail (recuperación de contraseña). Prioridad: RESEND_API_KEY > SMTP_HOST > logs.
# Resend (recomendado): https://resend.com — 100 emails/día gratis
RESEND_API_KEY=
SMTP_FROM=noreply@splitpayments.app
# Alternativa con SMTP (ej. Gmail con app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASSWORD=app-password

# Secrets
JWT_SECRET=change-me-in-production
SPLITTER_API_KEY=change-me-in-production
INVITE_CODE=your-invite-code

# Splitter public URL (para redirects de pago)
SPLITTER_PUBLIC_URL=http://192.168.1.21:4004
