# Required for Open Payments
WALLET_ADDRESS_URL=https://ilp.interledger-test.dev/your-wallet
KEY_ID=your-key-id-uuid

# Private key: either a file path or the base64-encoded key directly
PRIVATE_KEY_PATH=./private.key
# PRIVATE_KEY_PATH=base64:LS0tLS1CRUdJTi...

# Secrets — change in production
JWT_SECRET=change-me-in-production
SPLITTER_API_KEY=change-me-in-production
INVITE_CODE=your-invite-code

# Public URL of the splitter (for payment callbacks)
# For homelab: http://<your-server-ip>:4001
# For production with domain: https://splitter.yourdomain.com
SPLITTER_PUBLIC_URL=http://192.168.1.100:4001

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
